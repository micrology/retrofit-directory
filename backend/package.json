{
  "name": "retrofit-directory-backend",
  "private": true,
  "type": "module",
  "description": "Searchable UK housing-retrofit organisation directory (INHABIT / National Retrofit Hub)",
  "license": "MIT",
  "scripts": {
    "start": "node query.mjs",
    "import": "node csvToDB.mjs",
    "rebuild-view": "node rebuild-orgs-llm.mjs",
    "test": "npm run test:offline",
    "test:offline": "node test/test-validate-sql.mjs && node test/test-proximity.mjs",
    "test:security": "bash test/test-security.sh",
    "refresh": "bash ops/refresh-directory.sh",
    "deploy-db": "bash ops/deploy-directory-db.sh"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agent-runtime": "^3.1107.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1095.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "http-terminator": "^3.2.0",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  }
}
