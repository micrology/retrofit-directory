# /etc/systemd/system/retrofit-query-server.service
# Retrofit Directory backend query responder
#
# Install:
#   sudo cp backend/ops/retrofit-query-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now retrofit-query-server

[Unit]
Description=Retrofit Directory backend query responder
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/data/retrofit-directory/backend
ExecStart=/usr/bin/node /data/retrofit-directory/backend/query.mjs
Environment=AWS_REGION=eu-west-2
# Required to unlock POST /api/observe. Override on the host, e.g.:
#   sudo systemctl edit retrofit-query-server
#   [Service]
#   Environment=ADMIN_PASSWORD=your-long-secret
Environment=ADMIN_PASSWORD=
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=retrofit-query-server

[Install]
WantedBy=multi-user.target
